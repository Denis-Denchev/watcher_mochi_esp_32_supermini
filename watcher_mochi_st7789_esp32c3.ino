static void noteActionStarted(uint8_t index, uint32_t now) {
  if (index >= ACTION_SLOT_COUNT) {
    return;
  }
  lastActionStartMs = now;
  rememberAction(index);
  actionCooldownUntil[index] = now + actionCooldownMs(index);
  applyActionAftermath(index, now);
}

static void noteActionFinished(uint8_t index, uint32_t now) {
  if (index == PONG_MODE_INDEX) {
    lastPongMs = now;
  }
  lastActionEndMs = now;
}

static void resetPongBall(int8_t direction) {
  pongBallX = FRAME_X + (FRAME_W / 2);
  pongBallY = FRAME_Y + (FRAME_H / 2);
  pongBallVX = (direction >= 0) ? random(2, 4) : -random(2, 4);
  pongBallVY = random(-2, 3);
  if (pongBallVY == 0) {
    pongBallVY = (random(0, 2) == 0) ? -1 : 1;
  }
}

static void startPongMode() {
  const uint32_t now = millis();
  activeAnimation = PONG_MODE_INDEX;
  activeFrame = 0;
  playingAction = true;
  playingGlance = false;
  lastFrameMs = 0;
  holdUntilMs = 0;
  actionLoopUntilMs = now + PONG_DURATION_MS;
  pongLeftScore = 0;
  pongRightScore = 0;
  pongLeftPaddleY = FRAME_Y + (FRAME_H / 2) - 8;
  pongRightPaddleY = FRAME_Y + (FRAME_H / 2) - 8;
  noteActionStarted(PONG_MODE_INDEX, now);
  resetPongBall((random(0, 2) == 0) ? -1 : 1);
  clearVisibleArea();
}

static void updatePaddleTowards(int16_t &paddleY, int16_t targetY, int16_t maxStep) {
  if (targetY > paddleY + maxStep) {
    paddleY += maxStep;
  } else if (targetY < paddleY - maxStep) {
    paddleY -= maxStep;
  } else {
    paddleY = targetY;
  }

  const int16_t minY = FRAME_Y + 8;
  const int16_t maxY = FRAME_Y + FRAME_H - 8 - 16;
  if (paddleY < minY) {
    paddleY = minY;
  } else if (paddleY > maxY) {
    paddleY = maxY;
  }
}

static void updatePongMode(uint32_t now) {
  static constexpr int16_t paddleW = 4;
  static constexpr int16_t paddleH = 16;
  static constexpr int16_t ballR = 3;
  static constexpr int16_t leftX = FRAME_X + 24;
  static constexpr int16_t rightX = FRAME_X + FRAME_W - 24 - paddleW;
  static constexpr int16_t topWall = FRAME_Y + 8;
  static constexpr int16_t bottomWall = FRAME_Y + FRAME_H - 8;
  static constexpr int16_t midX = FRAME_X + (FRAME_W / 2);

  if ((int32_t)(now - actionLoopUntilMs) >= 0) {
    playingAction = false;
    playingGlance = false;
    noteActionFinished(PONG_MODE_INDEX, now);
    startAnimation(IDLE_ANIMATION_INDEX, false, false);
    scheduleNextAction(now);
    scheduleNextGlance(now);
    return;
  }

  if (lastFrameMs != 0 && (uint32_t)(now - lastFrameMs) < PONG_FRAME_MS) {
    return;
  }
  lastFrameMs = now;

  const int16_t leftTarget = pongBallY - (paddleH / 2) + random(-2, 3);
  const int16_t rightTarget = pongBallY - (paddleH / 2) + random(-3, 4);
  updatePaddleTowards(pongLeftPaddleY, leftTarget, 2);
  updatePaddleTowards(pongRightPaddleY, rightTarget, 3);

  pongBallX += pongBallVX;
  pongBallY += pongBallVY;

  if (pongBallY - ballR <= topWall) {
    pongBallY = topWall + ballR;
    pongBallVY = abs(pongBallVY);
  } else if (pongBallY + ballR >= bottomWall) {
    pongBallY = bottomWall - ballR;
    pongBallVY = -abs(pongBallVY);
  }

  if (pongBallVX < 0 &&
      pongBallX - ballR <= leftX + paddleW &&
      pongBallX - ballR >= leftX - 2 &&
      pongBallY >= pongLeftPaddleY - 1 &&
      pongBallY <= pongLeftPaddleY + paddleH + 1) {
    pongBallX = leftX + paddleW + ballR;
    pongBallVX = random(2, 4);
    pongBallVY += (pongBallY - (pongLeftPaddleY + (paddleH / 2))) / 5;
    if (pongBallVY < -3) {
      pongBallVY = -3;
    } else if (pongBallVY > 3) {
      pongBallVY = 3;
    }
  } else if (pongBallVX > 0 &&
             pongBallX + ballR >= rightX &&
             pongBallX + ballR <= rightX + paddleW + 2 &&
             pongBallY >= pongRightPaddleY - 1 &&
             pongBallY <= pongRightPaddleY + paddleH + 1) {
    pongBallX = rightX - ballR;
    pongBallVX = -random(2, 4);
    pongBallVY += (pongBallY - (pongRightPaddleY + (paddleH / 2))) / 5;
    if (pongBallVY < -3) {
      pongBallVY = -3;
    } else if (pongBallVY > 3) {
      pongBallVY = 3;
    }
  }

  if (pongBallX < FRAME_X + 6) {
    pongRightScore++;
    resetPongBall(-1);
  } else if (pongBallX > FRAME_X + FRAME_W - 6) {
    pongLeftScore++;
    resetPongBall(1);
  }

  tft.fillRect(VIEW_X_OFFSET, VIEW_Y_OFFSET, VISIBLE_W, VISIBLE_H, COLOR_BG);

  tft.drawRoundRect(FRAME_X + 4, FRAME_Y + 4, FRAME_W - 8, FRAME_H - 8, 8, COLOR_FACE);
  tft.drawFastHLine(FRAME_X + 16, topWall - 3, FRAME_W - 32, COLOR_FACE);
  tft.drawFastHLine(FRAME_X + 16, bottomWall + 2, FRAME_W - 32, COLOR_FACE);

  for (int16_t y = topWall; y < bottomWall; y += 10) {
    tft.drawFastVLine(midX, y, 5, COLOR_FACE);
  }

  tft.fillRoundRect(leftX, pongLeftPaddleY, paddleW, paddleH, 2, COLOR_FACE);
  tft.fillRoundRect(rightX, pongRightPaddleY, paddleW, paddleH, 2, COLOR_FACE);
  tft.fillCircle(pongBallX, pongBallY, ballR, COLOR_FACE);

  tft.setTextWrap(false);
  tft.setTextSize(1);
  tft.setTextColor(COLOR_FACE, COLOR_BG);
  tft.setCursor(FRAME_X + 31, FRAME_Y + 10);
  tft.print(pongLeftScore);
  tft.setCursor(FRAME_X + FRAME_W - 39, FRAME_Y + 10);
  tft.print(pongRightScore);
  tft.setCursor(midX - 11, FRAME_Y + FRAME_H - 14);
  tft.print("PONG");
}

static uint32_t randomActionDuration() {
  switch (random(0, 5)) {
    case 0:
      return random(4200, 6500);
    case 1:
      return random(7000, 10500);
    case 2:
      return random(10000, 15500);
    case 3:
      return random(5200, 8500);
    default:
      return random(8000, 13000);
  }
}

static void startAnimation(uint8_t index, bool action, bool glance = false) {
  if (index == PONG_MODE_INDEX) {
    startPongMode();
    return;
  }
  if (index >= ANIMATION_COUNT) {
    return;
  }
  activeAnimation = index;
  activeFrame = 0;
  playingAction = action;
  playingGlance = glance;
  lastFrameMs = 0;
  holdUntilMs = 0;
  actionLoopUntilMs = action ? (millis() + randomActionDuration()) : 0;
  if (glance) {
    if (index == LEFT_ANIMATION_INDEX) {
      lastGlanceDirection = -1;
    } else if (index == RIGHT_ANIMATION_INDEX) {
      lastGlanceDirection = 1;
    }
  }
  if (action) {
    noteActionStarted(index, millis());
  }
  clearVisibleArea();
}

static void scheduleNextAction(uint32_t now) {
  updateBehaviorState(now);
  uint32_t gapMin = 9000;
  uint32_t gapMax = 18000;
  const int16_t serialBonus = recentSerialBonus(now);

  if (serialBonus > 25) {
    gapMin = 3500;
    gapMax = 8500;
  } else if (brain.boredom > 75 || brain.mischief > 72) {
    gapMin = 4500;
    gapMax = 10000;
  } else if (brain.sleepPressure > 75) {
    gapMin = 14000;
    gapMax = 28000;
  } else if (brain.socialNeed > 60 || brain.curiosity > 65) {
    gapMin = 6500;
    gapMax = 13000;
  }

  nextActionMs = now + random((long)gapMin, (long)gapMax);
}

static void scheduleNextGlance(uint32_t now) {
  updateBehaviorState(now);
  uint32_t gapMin = GLANCE_MS_MIN;
  uint32_t gapMax = GLANCE_MS_MAX;
  const int16_t serialBonus = recentSerialBonus(now);

  if (serialBonus > 25 || brain.curiosity > 70) {
    gapMin = 1800;
    gapMax = 4200;
  } else if (brain.sleepPressure > 75) {
    gapMin = 4800;
    gapMax = 9000;
  } else if (brain.boredom > 65) {
    gapMin = 2400;
    gapMax = 5200;
  }

  nextGlanceMs = now + random((long)gapMin, (long)gapMax);
}

static void updateAnimation(uint32_t now) {
  if (activeAnimation == PONG_MODE_INDEX) {
    updatePongMode(now);
    return;
  }

  const AnimationDef &anim = animations[activeAnimation];
  const uint16_t frameMs = (playingAction || playingGlance) ? anim.frameMs : IDLE_FRAME_MS;

  if (holdUntilMs != 0) {
    if ((int32_t)(now - holdUntilMs) >= 0) {
      const bool finishedAction = playingAction;
      const bool finishedGlance = playingGlance;
      const uint8_t finishedAnimation = activeAnimation;
      holdUntilMs = 0;
      if (finishedAction || finishedGlance) {
        playingAction = false;
        playingGlance = false;
        if (finishedAction) {
          noteActionFinished(finishedAnimation, now);
        }
        startAnimation(IDLE_ANIMATION_INDEX, false);
        scheduleNextGlance(now);
        if (finishedAction) {
          scheduleNextAction(now);
        }
      }
    }
    return;
  }

  if (now - lastFrameMs < frameMs) {
    return;
  }
  lastFrameMs = now;

  drawFrame(anim, activeFrame);
  activeFrame++;

  if (activeFrame >= anim.frameCount) {
    if (playingAction) {
      if ((int32_t)(now - actionLoopUntilMs) < 0) {
        activeFrame = 0;
      } else {
        activeFrame = anim.frameCount - 1;
        holdUntilMs = now + anim.holdLastMs;
      }
    } else if (playingGlance) {
      activeFrame = anim.frameCount - 1;
      holdUntilMs = now + GLANCE_HOLD_MS;
    } else {
      activeFrame = 0;
    }
  }
}

static void printHelp() {
  Serial.println();
  Serial.println("Watcher Mochi ST7789 commands:");
  Serial.println("  next");
  Serial.println("  brain");
  Serial.println("  list");
  Serial.println("  idle");
  Serial.println("  smile happy left right wink sleepy laughing surprised angry squint hello dancing pong");
  Serial.println();
}

static void printList() {
  Serial.println("Animations:");
  for (uint8_t i = 0; i < ANIMATION_COUNT; i++) {
    Serial.print("  ");
    Serial.println(animations[i].name);
  }
  Serial.println("  pong");
}

static void processCommand(char *command) {
  while (*command == ' ' || *command == '\t') {
    command++;
  }
  char *end = command + strlen(command);
  while (end > command && (end[-1] == ' ' || end[-1] == '\t')) {
    end--;
  }
  *end = '\0';

  if (*command == '\0') {
    return;
  }

  adjustDrive(brain.curiosity, 8);
  adjustDrive(brain.sleepPressure, -6);
  adjustDrive(brain.socialNeed, -4);

  if (equalsIgnoreCase(command, "help")) {
    printHelp();
  } else if (equalsIgnoreCase(command, "brain")) {
    printBehaviorStatus();
  } else if (equalsIgnoreCase(command, "list")) {
    printList();
  } else if (equalsIgnoreCase(command, "next")) {
    startAnimation(pickBehaviorAction(millis()), true);
  } else if (equalsIgnoreCase(command, "pong")) {
    startAnimation(PONG_MODE_INDEX, true);
  } else if (equalsIgnoreCase(command, "idle") || equalsIgnoreCase(command, "smile")) {
    startAnimation(IDLE_ANIMATION_INDEX, false);
    lastActionEndMs = millis();
    scheduleNextAction(millis());
    scheduleNextGlance(millis());
  } else {
    uint8_t index = findAnimationByName(command);
    if (index != 255) {
      const bool isGlance = index == LEFT_ANIMATION_INDEX || index == RIGHT_ANIMATION_INDEX;
      startAnimation(index, index != IDLE_ANIMATION_INDEX && !isGlance, isGlance);
    } else {
      Serial.print("Unknown command: ");
      Serial.println(command);
      printHelp();
    }
  }
}

static void handleSerial() {
  while (Serial.available() > 0) {
    const char c = (char)Serial.read();
    lastSerialActivityMs = millis();
    if (serialBurst < 12) {
      serialBurst++;
    }
    if (c == '\r') {
      continue;
    }
    if (c == '\n') {
      serialBuffer[serialBufferLen] = '\0';
      processCommand(serialBuffer);
      serialBufferLen = 0;
      continue;
    }
    if (serialBufferLen < sizeof(serialBuffer) - 1) {
      serialBuffer[serialBufferLen++] = c;
    }
  }
}

void setup() {
  Serial.begin(115200);
  delay(60);
  Serial.println("Watcher Mochi ST7789 booting...");
  printHelp();

  pinMode(PIN_TFT_BL, OUTPUT);
  setBacklight(false);

  SPI.begin(PIN_TFT_SCLK, PIN_TFT_MISO, PIN_TFT_MOSI, PIN_TFT_CS);
  tft.init(TFT_INIT_WIDTH, TFT_INIT_HEIGHT);
  // If your exact ST7789 panel needs it, try:
  // tft.init(TFT_INIT_WIDTH, TFT_INIT_HEIGHT, SPI_MODE2);
  tft.setSPISpeed(SPI_SPEED_HZ);
  tft.setRotation(TFT_ROTATION);
  tft.invertDisplay(TFT_INVERT_COLORS);
  tft.fillScreen(COLOR_BG);

  setBacklight(true);

  if (RUN_BOOT_TEST) {
    runBootTest();
  }

  randomSeed((uint32_t)micros());
  sessionStartMs = millis();
  lastBehaviorTickMs = sessionStartMs;
  lastActionEndMs = sessionStartMs;
  startAnimation(IDLE_ANIMATION_INDEX, false);
  scheduleNextAction(millis());
  scheduleNextGlance(millis());
}

void loop() {
  handleSerial();
  const uint32_t now = millis();
  updateBehaviorState(now);

  if (!playingAction && !playingGlance && (int32_t)(now - nextActionMs) >= 0) {
    startAnimation(pickBehaviorAction(now), true);
  } else if (!playingAction && !playingGlance && (int32_t)(now - nextGlanceMs) >= 0) {
    startAnimation(pickBehaviorGlance(now), false, true);
  }

  updateAnimation(now);
}
