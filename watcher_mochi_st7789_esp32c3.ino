static uint8_t clampDrive(int16_t value) {
  if (value < 0) {
    return 0;
  }
  if (value > 100) {
    return 100;
  }
  return (uint8_t)value;
}

static void adjustDrive(uint8_t &value, int16_t delta) {
  value = clampDrive((int16_t)value + delta);
}

static void rememberAction(uint8_t index) {
  for (int8_t i = RECENT_ACTION_COUNT - 1; i > 0; i--) {
    recentActions[i] = recentActions[i - 1];
  }
  recentActions[0] = index;
}

static int16_t recentPenalty(uint8_t index) {
  static const int16_t penalties[RECENT_ACTION_COUNT] = {38, 22, 12, 6};
  int16_t total = 0;
  for (uint8_t i = 0; i < RECENT_ACTION_COUNT; i++) {
    if (recentActions[i] == index) {
      total += penalties[i];
    }
  }
  return total;
}

static uint32_t actionCooldownMs(uint8_t index) {
  switch (index) {
    case HAPPY_ANIMATION_INDEX:
      return 26000;
    case WINK_ANIMATION_INDEX:
      return 32000;
    case SLEEPY_ANIMATION_INDEX:
      return 95000;
    case LAUGHING_ANIMATION_INDEX:
      return 36000;
    case SURPRISED_ANIMATION_INDEX:
      return 48000;
    case ANGRY_ANIMATION_INDEX:
      return 65000;
    case SQUINT_ANIMATION_INDEX:
      return 42000;
    case HELLO_ANIMATION_INDEX:
      return 45000;
    case DANCING_ANIMATION_INDEX:
      return 65000;
    case PONG_MODE_INDEX:
      return PONG_MIN_GAP_MS;
    default:
      return 22000;
  }
}

static int16_t recentSerialBonus(uint32_t now) {
  if (lastSerialActivityMs == 0) {
    return 0;
  }
  const uint32_t age = now - lastSerialActivityMs;
  if (age < 5000) {
    return 46;
  }
  if (age < 12000) {
    return 26;
  }
  if (age < SERIAL_REACTION_MS) {
    return 12;
  }
  return 0;
}

static uint32_t idleDurationMs(uint32_t now) {
  if (playingAction || playingGlance || activeAnimation != IDLE_ANIMATION_INDEX) {
    return 0;
  }
  return now - lastActionEndMs;
}

static void applyActionAftermath(uint8_t index, uint32_t now) {
  switch (index) {
    case HAPPY_ANIMATION_INDEX:
      adjustDrive(brain.boredom, -16);
      adjustDrive(brain.socialNeed, -8);
      adjustDrive(brain.energy, -4);
      break;
    case WINK_ANIMATION_INDEX:
      adjustDrive(brain.socialNeed, -12);
      adjustDrive(brain.curiosity, -4);
      adjustDrive(brain.sleepPressure, -4);
      break;
    case SLEEPY_ANIMATION_INDEX:
      adjustDrive(brain.sleepPressure, -44);
      adjustDrive(brain.energy, 10);
      adjustDrive(brain.boredom, -6);
      break;
    case LAUGHING_ANIMATION_INDEX:
      adjustDrive(brain.boredom, -20);
      adjustDrive(brain.socialNeed, -14);
      adjustDrive(brain.mischief, -8);
      break;
    case SURPRISED_ANIMATION_INDEX:
      adjustDrive(brain.curiosity, -8);
      adjustDrive(brain.energy, 4);
      break;
    case ANGRY_ANIMATION_INDEX:
      adjustDrive(brain.mischief, -10);
      adjustDrive(brain.energy, -6);
      break;
    case SQUINT_ANIMATION_INDEX:
      adjustDrive(brain.curiosity, -10);
      adjustDrive(brain.boredom, -4);
      break;
    case HELLO_ANIMATION_INDEX:
      adjustDrive(brain.socialNeed, -26);
      adjustDrive(brain.energy, 4);
      break;
    case DANCING_ANIMATION_INDEX:
      adjustDrive(brain.boredom, -24);
      adjustDrive(brain.energy, -16);
      adjustDrive(brain.mischief, -12);
      break;
    case PONG_MODE_INDEX:
      adjustDrive(brain.boredom, -42);
      adjustDrive(brain.mischief, -16);
      adjustDrive(brain.sleepPressure, -10);
      adjustDrive(brain.energy, -8);
      lastPongMs = now;
      break;
    default:
      break;
  }
}

static void updateBehaviorState(uint32_t now) {
  if (lastBehaviorTickMs == 0) {
    lastBehaviorTickMs = now;
  }

  while ((uint32_t)(now - lastBehaviorTickMs) >= BEHAVIOR_TICK_MS) {
    const uint32_t previousTick = lastBehaviorTickMs;
    lastBehaviorTickMs += BEHAVIOR_TICK_MS;
    const bool idle = !playingAction && !playingGlance && activeAnimation == IDLE_ANIMATION_INDEX;
    const uint32_t idleMs = idle ? (lastBehaviorTickMs - lastActionEndMs) : 0;
    const bool serialHot = lastSerialActivityMs != 0 &&
                           (lastBehaviorTickMs - lastSerialActivityMs) < SERIAL_REACTION_MS;

    if (idle) {
      adjustDrive(brain.boredom, idleMs > 80000 ? 3 : (idleMs > 25000 ? 2 : 1));
      adjustDrive(brain.curiosity, idleMs > 12000 ? 1 : 0);
      adjustDrive(brain.socialNeed, 1);
      if (brain.sleepPressure < 70) {
        adjustDrive(brain.energy, 1);
      }
    } else {
      adjustDrive(brain.boredom, -2);
      adjustDrive(brain.energy, -1);
      adjustDrive(brain.socialNeed, -1);
    }

    if (idleMs > 70000) {
      adjustDrive(brain.sleepPressure, 1);
    }
    if (brain.sleepPressure > 72) {
      adjustDrive(brain.energy, -1);
    }

    if (brain.boredom > 60) {
      adjustDrive(brain.mischief, 1);
    } else {
      adjustDrive(brain.mischief, -1);
    }

    if (serialHot) {
      adjustDrive(brain.curiosity, 2);
      adjustDrive(brain.energy, 1);
      adjustDrive(brain.sleepPressure, -2);
      if (serialBurst > 2) {
        adjustDrive(brain.mischief, 1);
      }
    } else if (serialBurst > 0 &&
               (previousTick / 3000UL) != (lastBehaviorTickMs / 3000UL)) {
      serialBurst--;
    }
  }
}

static int16_t scoreBehaviorAction(uint8_t index, uint32_t now) {
  if (index < ACTION_SLOT_COUNT &&
      (int32_t)(now - actionCooldownUntil[index]) < 0) {
    return -32000;
  }
  if (index == PONG_MODE_INDEX && lastPongMs != 0 &&
      (uint32_t)(now - lastPongMs) < PONG_MIN_GAP_MS) {
    return -32000;
  }

  const int16_t serialBonus = recentSerialBonus(now);
  const int16_t idleSecs = (int16_t)(idleDurationMs(now) / 1000UL);
  int16_t score = 0;

  switch (index) {
    case HAPPY_ANIMATION_INDEX:
      score = 18 + (brain.energy / 2) + (brain.socialNeed / 4) + (serialBonus / 5) - (brain.sleepPressure / 4);
      break;
    case WINK_ANIMATION_INDEX:
      score = 10 + (brain.curiosity / 2) + (serialBonus / 2) + (brain.socialNeed / 5);
      break;
    case SLEEPY_ANIMATION_INDEX:
      score = 6 + brain.sleepPressure + max(0, 35 - (int16_t)brain.energy) + (idleSecs / 2);
      break;
    case LAUGHING_ANIMATION_INDEX:
      score = 12 + (brain.mischief / 2) + (brain.socialNeed / 4) + (serialBonus / 3);
      break;
    case SURPRISED_ANIMATION_INDEX:
      score = 4 + serialBonus + ((serialBurst >= 3) ? 12 : 0) + (brain.curiosity / 4);
      break;
    case ANGRY_ANIMATION_INDEX:
      score = 2 + ((serialBurst >= 5) ? 50 : 0) + ((brain.boredom > 85) ? 8 : 0) - (brain.socialNeed / 4);
      break;
    case SQUINT_ANIMATION_INDEX:
      score = 14 + (brain.curiosity / 2) + (brain.sleepPressure / 3) + (idleSecs / 3);
      break;
    case HELLO_ANIMATION_INDEX:
      score = 8 + serialBonus + (brain.socialNeed / 2);
      break;
    case DANCING_ANIMATION_INDEX:
      score = 8 + (brain.energy / 2) + (brain.mischief / 2) - (brain.sleepPressure / 3) - (idleSecs / 4);
      break;
    case PONG_MODE_INDEX:
      score = 4 + brain.boredom + (brain.mischief / 2) + (idleSecs / 2) +
              ((lastPongMs == 0 || (uint32_t)(now - lastPongMs) > 150000UL) ? 28 : 0);
      break;
    default:
      return -32000;
  }

  if (index == HELLO_ANIMATION_INDEX && serialBonus == 0) {
    score -= 16;
  }
  if (index == SURPRISED_ANIMATION_INDEX && serialBonus == 0) {
    score -= 10;
  }
  if (index == ANGRY_ANIMATION_INDEX && serialBurst < 3) {
    score -= 24;
  }
  if (index == SLEEPY_ANIMATION_INDEX && brain.sleepPressure < 35) {
    score -= 18;
  }
  if (index == DANCING_ANIMATION_INDEX && brain.energy < 30) {
    score -= 20;
  }
  if (index == LAUGHING_ANIMATION_INDEX && brain.socialNeed < 20 && serialBonus == 0) {
    score -= 8;
  }
  if (index == PONG_MODE_INDEX && brain.boredom < 35) {
    score -= 18;
  }

  score -= recentPenalty(index);
  return score;
}

static uint8_t pickBehaviorAction(uint32_t now) {
  static const uint8_t candidates[] = {
    HAPPY_ANIMATION_INDEX,
    WINK_ANIMATION_INDEX,
    SLEEPY_ANIMATION_INDEX,
    LAUGHING_ANIMATION_INDEX,
    SURPRISED_ANIMATION_INDEX,
    ANGRY_ANIMATION_INDEX,
    SQUINT_ANIMATION_INDEX,
    HELLO_ANIMATION_INDEX,
    DANCING_ANIMATION_INDEX,
    PONG_MODE_INDEX
  };

  updateBehaviorState(now);

  const int16_t serialBonus = recentSerialBonus(now);
  if (serialBonus >= 35 && scoreBehaviorAction(HELLO_ANIMATION_INDEX, now) > 0 && random(0, 100) < 45) {
    return HELLO_ANIMATION_INDEX;
  }
  if (serialBonus >= 35 && scoreBehaviorAction(WINK_ANIMATION_INDEX, now) > 0 && random(0, 100) < 28) {
    return WINK_ANIMATION_INDEX;
  }
  if (brain.sleepPressure > 86 && scoreBehaviorAction(SLEEPY_ANIMATION_INDEX, now) > 0) {
    return SLEEPY_ANIMATION_INDEX;
  }
  if (brain.boredom > 82 && scoreBehaviorAction(PONG_MODE_INDEX, now) > 0 && random(0, 100) < 65) {
    return PONG_MODE_INDEX;
  }

  int32_t total = 0;
  int16_t scores[sizeof(candidates)];
  for (uint8_t i = 0; i < sizeof(candidates); i++) {
    int16_t score = scoreBehaviorAction(candidates[i], now);
    if (score < 0) {
      score = 0;
    }
    scores[i] = score;
    total += score;
  }

  if (total <= 0) {
    if (scoreBehaviorAction(SQUINT_ANIMATION_INDEX, now) > 0) {
      return SQUINT_ANIMATION_INDEX;
    }
    return HAPPY_ANIMATION_INDEX;
  }

  int32_t roll = random(0, total);
  for (uint8_t i = 0; i < sizeof(candidates); i++) {
    if (roll < scores[i]) {
      return candidates[i];
    }
    roll -= scores[i];
  }
  return candidates[0];
}

static uint8_t pickBehaviorGlance(uint32_t now) {
  updateBehaviorState(now);

  int16_t leftScore = brain.curiosity + ((lastGlanceDirection == -1) ? -18 : 10);
  int16_t rightScore = brain.curiosity + ((lastGlanceDirection == 1) ? -18 : 10);
  const int16_t serialBonus = recentSerialBonus(now) / 4;

  if (serialBonus > 0) {
    if (lastGlanceDirection <= 0) {
      rightScore += serialBonus;
    } else {
      leftScore += serialBonus;
    }
  }
  if (brain.mischief > 65 && random(0, 100) < 25) {
    leftScore += 8;
  }
  if (brain.sleepPressure > 70) {
    leftScore -= 6;
    rightScore -= 6;
  }

  const bool chooseLeft = (leftScore == rightScore) ? (random(0, 2) == 0) : (leftScore > rightScore);
  lastGlanceDirection = chooseLeft ? -1 : 1;
  return chooseLeft ? LEFT_ANIMATION_INDEX : RIGHT_ANIMATION_INDEX;
}

