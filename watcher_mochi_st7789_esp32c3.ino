static uint8_t findAnimationByName(const char *name) {
  for (uint8_t i = 0; i < ANIMATION_COUNT; i++) {
    const char *candidate = animations[i].name;
    uint8_t j = 0;
    bool match = true;
    while (name[j] != '\0' || candidate[j] != '\0') {
      if (toupper((unsigned char)name[j]) != toupper((unsigned char)candidate[j])) {
        match = false;
        break;
      }
      j++;
    }
    if (match) {
      return i;
    }
  }
  return 255;
}

static bool equalsIgnoreCase(const char *a, const char *b) {
  while (*a != '\0' && *b != '\0') {
    if (toupper((unsigned char)*a) != toupper((unsigned char)*b)) {
      return false;
    }
    a++;
    b++;
  }
  return *a == '\0' && *b == '\0';
}

