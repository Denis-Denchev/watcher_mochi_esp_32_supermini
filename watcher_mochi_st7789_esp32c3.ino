}

static void drawFrame(const AnimationDef &anim, uint8_t frameIndex) {
  const uint32_t base = (uint32_t)frameIndex * FRAME_BYTES;

  for (int16_t y = 0; y < FRAME_H; y++) {
    const uint32_t rowOffset = base + ((uint32_t)y * FRAME_BYTES_PER_ROW);
    for (int16_t x = 0; x < FRAME_W; x++) {
      const uint8_t packed = pgm_read_byte(anim.frames + rowOffset + (x >> 3));
      const bool pixel = (packed & (0x80 >> (x & 7))) != 0;
      frameLine[x] = pixel ? COLOR_FACE : COLOR_BG;
    }
    tft.drawRGBBitmap(FRAME_X, FRAME_Y + y, frameLine, FRAME_W, 1);
  }
}

static void drawTextCentered(int16_t y, const char *text, uint8_t textSize) {
  tft.setTextWrap(false);
  tft.setTextSize(textSize);
  tft.setTextColor(COLOR_FACE, COLOR_BG);
  const int16_t width = strlen(text) * 6 * textSize;
  int16_t x = VIEW_X_OFFSET + ((VISIBLE_W - width) / 2);
  if (x < VIEW_X_OFFSET) {
    x = VIEW_X_OFFSET;
  }
  tft.setCursor(x, VIEW_Y_OFFSET + y);
  tft.print(text);
}

